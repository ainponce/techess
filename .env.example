# Supabase — valores reales van en .env.local (no se commitea).
# Conseguilos en: Supabase Dashboard → Project Settings → API.
# La publishable key es segura de exponer al cliente; la seguridad viene del
# RLS en la tabla techess_registrations (insert-only para anon).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
